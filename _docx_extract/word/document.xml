s/></w:rPr></w:pPr><w:r w:rsidRPr="00EA1F05"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Where did the INFO comments come from? Maybe we can review them if they are applicable or not.</w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve"> Another example below which is confusing:</w:t></w:r></w:p><w:p w14:paraId="5338D302" w14:textId="0EB1EBB0" w:rsidR="00EA1F05" w:rsidRPr="00EA1F05" w:rsidRDefault="00EA1F05"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00EA1F05"><w:rPr><w:b/><w:bCs/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="5AAB6A9F" wp14:editId="68E1F4C2"><wp:extent cx="5731510" cy="326390"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="238933159" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="238933159" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId15"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5731510" cy="326390"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="5DFA7413" w14:textId="77777777" w:rsidR="00EA1F05" w:rsidRDefault="00EA1F05"/><w:p w14:paraId="0B57FBE0" w14:textId="2D807652" w:rsidR="009B52D3" w:rsidRDefault="009B52D3" w:rsidP="009B52D3"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="12" w:name="_Toc225263896"/><w:r><w:t>“Percentage” with status</w:t></w:r><w:bookmarkEnd w:id="12"/></w:p><w:p w14:paraId="62E8924D" w14:textId="3198EA1A" w:rsidR="009B52D3" w:rsidRDefault="000B33FE"><w:r><w:t xml:space="preserve">A common thing someone may do is put “_status” at the end of a analogue point name, e.g. </w:t></w:r></w:p><w:p w14:paraId="56593636" w14:textId="0B7E5E84" w:rsidR="000B33FE" w:rsidRDefault="000B33FE"><w:r w:rsidRPr="000B33FE"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="09FCA03C" wp14:editId="432A0156"><wp:extent cx="5731510" cy="2822575"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="1144199674" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1144199674" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId16"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5731510" cy="2822575"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="457F8EA9" w14:textId="73332BB3" w:rsidR="000B33FE" w:rsidRDefault="000B33FE"><w:r><w:t>It would be good to flag up when people try this for analogue point names.</w:t></w:r></w:p><w:p w14:paraId="60B36178" w14:textId="77777777" w:rsidR="009B52D3" w:rsidRDefault="009B52D3"/><w:p w14:paraId="2C6CE591" w14:textId="498E84E8" w:rsidR="000B33FE" w:rsidRDefault="000B33FE" w:rsidP="000B33FE"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="13" w:name="_Toc225263897"/><w:r><w:lastRenderedPageBreak/><w:t>Duplicate subfield names check</w:t></w:r><w:bookmarkEnd w:id="13"/></w:p><w:p w14:paraId="444EB364" w14:textId="62AA49B5" w:rsidR="009B52D3" w:rsidRDefault="000B33FE"><w:r w:rsidRPr="000B33FE"><w:drawing><wp:inline distT