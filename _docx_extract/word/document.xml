><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">DBO Point Name – ONLY the point name, not the purple bit… </w:t></w:r></w:p><w:p w14:paraId="50373431" w14:textId="77777777" w:rsidR="00FB6A57" w:rsidRDefault="00FB6A57" w:rsidP="00FB6A57"/><w:p w14:paraId="5459329C" w14:textId="32626B59" w:rsidR="00833407" w:rsidRDefault="00FB6A57" w:rsidP="00FB6A57"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:bookmarkStart w:id="5" w:name="_Toc225263889"/><w:r><w:t>Notes in Point Library – ADMIN ACCESS ONLY</w:t></w:r><w:bookmarkEnd w:id="5"/></w:p><w:p w14:paraId="2EFAA9A8" w14:textId="2A299B7B" w:rsidR="00EE547E" w:rsidRDefault="00EE547E" w:rsidP="00833407"/><w:p w14:paraId="39A40997" w14:textId="293A9F10" w:rsidR="00833407" w:rsidRDefault="00833407" w:rsidP="00833407"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:bookmarkStart w:id="6" w:name="_Toc225263890"/><w:r><w:t>By Equipment – Required section</w:t></w:r><w:bookmarkEnd w:id="6"/></w:p><w:p w14:paraId="7970F4FB" w14:textId="02D30567" w:rsidR="00833407" w:rsidRDefault="00FB6A57" w:rsidP="00FB6A57"><w:r><w:t>Remove required and optional, and just keep All Points section.</w:t></w:r></w:p><w:p w14:paraId="7173D76B" w14:textId="24FFECB2" w:rsidR="00AF1948" w:rsidRDefault="00AF1948" w:rsidP="00833407"><w:r w:rsidRPr="00AF1948"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="09283FBC" wp14:editId="666176C3"><wp:extent cx="5731510" cy="2940685"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="137760276" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="137760276" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5731510" cy="2940685"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="2A8539A6" w14:textId="183B102E" w:rsidR="001E358A" w:rsidRDefault="00EF78CE" w:rsidP="001E358A"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:bookmarkStart w:id="7" w:name="_Toc225263891"/><w:r><w:lastRenderedPageBreak/><w:t>DBO Point Name Builder Comments</w:t></w:r><w:bookmarkEnd w:id="7"/></w:p><w:p w14:paraId="6F27BA9C" w14:textId="0D278946" w:rsidR="001E358A" w:rsidRDefault="001E358A" w:rsidP="001E358A"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="8" w:name="_Toc225263892"/><w:r><w:t>Descriptors can be multiple</w:t></w:r><w:bookmarkEnd w:id="8"/></w:p><w:p w14:paraId="1D958658" w14:textId="1A6A8E85" w:rsidR="001E358A" w:rsidRDefault="001E358A" w:rsidP="001E358A"><w:r><w:t>There can be multiple descriptors in DBO names, but the name builder only allows for one descriptor, so supply_air_temperature_sensor cannot be made as it has two descriptors.</w:t></w:r></w:p><w:p w14:paraId="73B65B19" w14:textId="4613731D" w:rsidR="001E358A" w:rsidRDefault="001E358A" w:rsidP="001E358A"><w:r w:rsidRPr="001E358A"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="7333E870" wp14:editId="24954207"><wp:extent cx="5731510" cy="1939290"/><wp:effectExtent l="0" t="0" r="2540" b="3810"/><wp:docPr id="1769041305" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"