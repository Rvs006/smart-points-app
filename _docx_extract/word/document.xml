ce="preserve">Design engineer suggests some points, then uploads the point names. MSI would then approve it before it is added to the main point naming pool. </w:t></w:r></w:p><w:p w14:paraId="37966408" w14:textId="0AE8E445" w:rsidR="00A75F8B" w:rsidRDefault="00A75F8B" w:rsidP="00A75F8B"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>When they upload it, it would give them confirmation if their suggested names are correct or not.</w:t></w:r></w:p><w:p w14:paraId="75001CC8" w14:textId="16F567DF" w:rsidR="003C25E4" w:rsidRDefault="003C25E4" w:rsidP="003C25E4"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:bookmarkStart w:id="1" w:name="_Toc225263885"/><w:r><w:t>Note for design engineers</w:t></w:r><w:bookmarkEnd w:id="1"/></w:p><w:p w14:paraId="7C929C00" w14:textId="02FADAA6" w:rsidR="00A75F8B" w:rsidRPr="00A75F8B" w:rsidRDefault="00A75F8B" w:rsidP="00A75F8B"><w:r w:rsidRPr="00A75F8B"><w:rPr><w:highlight w:val="yellow"/></w:rPr><w:t>**ADD ON FOR LATER ON</w:t></w:r></w:p><w:p w14:paraId="55447C22" w14:textId="77777777" w:rsidR="003C25E4" w:rsidRDefault="003C25E4" w:rsidP="003C25E4"><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">Keep in mind that the design engineers would like to have a set list of AHU points for each type of AHU they deal with. In projects they come across all sorts of AHUs, so we would ideally like to get all the different types of AHU points and assign smart/DBO names. </w:t></w:r></w:p><w:p w14:paraId="62E7713B" w14:textId="74F3C9F7" w:rsidR="003C25E4" w:rsidRDefault="003C25E4" w:rsidP="003C25E4"><w:pPr><w:jc w:val="both"/></w:pPr><w:r><w:t>E.g. if they are interfacing with a SystemAir AHU, they can then filter by SystemAir AHU points and then can potentially incorporate those points into their smart point schedules.</w:t></w:r><w:r w:rsidR="001E358A"><w:t xml:space="preserve"> Maybe by equipment can drill down into the different types of AHUs when the user clicks on AHU:</w:t></w:r></w:p><w:p w14:paraId="31E764C2" w14:textId="620A5800" w:rsidR="001E358A" w:rsidRDefault="001E358A" w:rsidP="003C25E4"><w:pPr><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="001E358A"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="41DEEC84" wp14:editId="601527BD"><wp:extent cx="5731510" cy="2157095"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="1094828286" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1094828286" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId6"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5731510" cy="2157095"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="5FB73F85" w14:textId="77777777" w:rsidR="003C25E4" w:rsidRDefault="003C25E4"/><w:p w14:paraId="1482F1A5" w14:textId="2027637E" w:rsidR="00EA1F05" w:rsidRDefault="00EA1F05" w:rsidP="00EA1F05"><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:bookmarkStart w:id="2" w:name="_Toc225263886"/><w:r><w:t>Tool DBO Updating</w:t></w:r><w:bookmarkEnd w:id="2"/></w:p><w:p w14:paraId="59041EA4" w14:textId="550B2568" w:rsidR="00EA1F05" w:rsidRDefault="00EA1F05"><w:r><w:t>Confirmation – does the tool automatically check for DBO field and subfield updates?</w:t></w:r></w:p><w:p w14:paraId="11234867" w14:textId="4E1D40B5" w:rsidR="00EA1F05" w:rsidRDefault="00EA1F05"/><w:p w14:paraId="3173F942" w14:textId="675360A9" w:rsidR="000B33FE" w:rsidRDefault="000B33FE" w:rsidP=